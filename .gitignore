# Python bytecode and local tool caches
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/
.cache/

# Local environments and secrets
.venv/
venv/
env/
.env
.env.*
!.env.example

# Build and packaging output
build/
dist/
*.egg
*.egg-info/

# Logs and local runtime output
*.log
*.out
logs/
logs_*/
wandb/
.wandb/
GUI/outputs/

# Raw experiment artifacts stay local. Git tracks experiment entrypoints and
# the condensed reports under docs/results/, never individual runs/evaluations.
experiments/**/20[0-9]*/
experiments/**/eval*/
experiments/**/_eval*/
experiments/**/run_config.json
experiments/**/results.json
experiments/**/*_sample_*_program.py
experiments/**/heldout_selection_note.json
experiments/**/selected_finite.json
experiments/**/tmux_run.log
experiments/**/logs/
experiments/**/logs_*/

# Historical experiment artifacts are retained locally; archive notes remain
# trackable.
archive/**/experiments/

# Local task datasets and downloaded model/data caches
llm4ad/task/optimization/*/data/
.huggingface/

# OS, editor, and temporary files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Local helper files from the legacy GUI/scripts
sample2pkl.py
gui_test.py
ysy_main.py
experiments/.traceaad_v4_slot_queue.json
